<?xml version="1.0" encoding="utf-8"?>
<Mod id="zatygolds-oberver-mode" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_ZOM_NAME</Name>
        <Description>LOC_MOD_ZOM_DESCRIPTION</Description>
        <Authors>Zatygold</Authors>
        <Package>Mod</Package>
        <AffectsSavedGames>0</AffectsSavedGames>
        <Version>0.6.04</Version>
        <LastUpdated>2026-10-03</LastUpdated>
        <ShowInBrowser>1</ShowInBrowser>
    </Properties>

    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
        <Mod id="age-antiquity" title="LOC_MODULE_AGE_ANTIQUITY_NAME"/>
        <Mod id="age-exploration" title="LOC_MODULE_AGE_EXPLORATION_NAME"/>
        <Mod id="age-modern" title="LOC_MODULE_AGE_MODERN_NAME"/>
    </Dependencies>

    <ActionCriteria>
        <Criteria id="always"><AlwaysMet/></Criteria>

<!--*************************** CRITERIA: OBSERVER ************************************************-->

        <!-- A game with an Observer: a player's leader is the Observer, or the
             hidden game option the lobby host sets when one is picked. -->
        <Criteria id="zom-observer-in-game" any="true">
            <ConfigurationValueContains>
                <Group>Player</Group>
                <ConfigurationId>LeaderTypeName</ConfigurationId>
                <Value>LEADER_ZOM_OBSERVER</Value>
            </ConfigurationValueContains>
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>ZOM_OBSERVER_IN_GAME</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
    </ActionCriteria>

<!--*************************** SHELL: LOBBY, TEXT & SETUP ***********************************************-->

    <ActionGroups>
        <ActionGroup id="zom-shell" scope="shell" criteria="always">
            <Properties><LoadOrder>1000</LoadOrder></Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/zom-text.xml</Item>
                </UpdateText>
                <UpdateDatabase>
                    <Item>config/SetupParameters.sql</Item>
                    <Item>config/observer-config.xml</Item>
                </UpdateDatabase>
                <ImportFiles>
                    <Item>icons/zom_observer.png</Item>
                    <Item>icons/zom_observer_civ.png</Item>
                    <Item>icons/zom_observer_leader_256.png</Item>
                    <Item>icons/zom_observer_leader_140.png</Item>
                    <Item>icons/zom_observer_leader_128.png</Item>
                    <Item>icons/zom_observer_leader_64.png</Item>
                    <Item>icons/zom_observer_circle_256.png</Item>
                    <Item>icons/zom_observer_circle_140.png</Item>
                    <Item>icons/zom_observer_circle_128.png</Item>
                    <Item>icons/zom_observer_circle_64.png</Item>
                </ImportFiles>
                <UpdateIcons>
                    <Item>data/observer/observer-icons.xml</Item>
                </UpdateIcons>
                <UpdateColors>
                    <Item>data/observer/observer-colors.xml</Item>
                </UpdateColors>
                <UIScripts>
                    <Item>ui/zom-shared/zom-util.js</Item>
                    <Item>ui/mp-lobby/mp-lobby-config.js</Item>
                    <Item>ui/mp-lobby/mp-lobby-observer.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>

<!--***************************** GAME: TEXT & SHARED HELPERS *************************************-->

        <ActionGroup id="zom-game-text" scope="game" criteria="always">
            <Properties><LoadOrder>500</LoadOrder></Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/zom-text.xml</Item>
                </UpdateText>
                <UIScripts>
                    <Item>ui/zom-shared/zom-util.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>

<!--*********************** GAME: OBSERVER LEADER & CIVILIZATIONS ******************************-->

        <ActionGroup id="zom-observer" scope="game" criteria="always">
            <Properties><LoadOrder>1000</LoadOrder></Properties>
            <Actions>
                <ImportFiles>
                    <Item>maps/zom-observer-eye.js</Item>
                </ImportFiles>
                <UpdateDatabase>
                    <Item>data/observer/observer-leader.xml</Item>
                    <Item>data/observer/observer-civilizations.xml</Item>
                    <Item>data/observer/observer-units-gameeffects.xml</Item>
                    <Item>data/observer/observer-units.xml</Item>
                    <Item>data/observer/observer-legacies.sql</Item>
                </UpdateDatabase>
                <ImportFiles>
                    <Item>icons/zom_observer.png</Item>
                    <Item>icons/zom_observer_civ.png</Item>
                    <Item>icons/zom_observer_leader_256.png</Item>
                    <Item>icons/zom_observer_leader_140.png</Item>
                    <Item>icons/zom_observer_leader_128.png</Item>
                    <Item>icons/zom_observer_leader_64.png</Item>
                    <Item>icons/zom_observer_circle_256.png</Item>
                    <Item>icons/zom_observer_circle_140.png</Item>
                    <Item>icons/zom_observer_circle_128.png</Item>
                    <Item>icons/zom_observer_circle_64.png</Item>
                </ImportFiles>
                <UpdateIcons>
                    <Item>data/observer/observer-icons.xml</Item>
                </UpdateIcons>
                <UpdateColors>
                    <Item>data/observer/observer-colors.xml</Item>
                </UpdateColors>
                <UIScripts>
                    <Item>ui/mp-observer/mp-observer-config.js</Item>
                    <Item>ui/mp-observer/mp-observer-core.js</Item>
                    <Item>ui/mp-observer/mp-observer-overview.js</Item>
                    <Item>ui/mp-observer/mp-observer-screens.js</Item>
                    <Item>ui/mp-observer/mp-observer-leader-view.js</Item>
                    <Item>ui/mp-observer/mp-observer-leader-screens.js</Item>
                    <Item>ui/mp-observer/mp-observer-civ-lists.js</Item>
                    <Item>ui/mp-observer/mp-observer-ribbon-data.js</Item>
                    <Item>ui/mp-observer/mp-observer-ribbon-style.js</Item>
                    <Item>ui/mp-observer/mp-observer-history.js</Item>
                    <Item>ui/mp-observer/mp-observer-graphs.js</Item>
                    <Item>ui/mp-observer/mp-observer-turn.js</Item>
                    <Item>ui/mp-observer/mp-observer-ribbon-toolbar.js</Item>
                    <Item>ui/mp-observer/mp-observer-ribbon.js</Item>
                    <Item>ui/mp-observer/mp-observer-navigation.js</Item>
                    <Item>ui/mp-observer/mp-observer-victory.js</Item>
                    <Item>ui/mp-observer/mp-observer-diplomacy.js</Item>
                    <Item>ui/mp-observer/mp-observer-yields.js</Item>
                    <Item>ui/mp-observer/mp-observer-hud.js</Item>
                    <Item>ui/mp-observer/mp-observer-units.js</Item>
                    <Item>ui/mp-observer/mp-observer-combat.js</Item>
                    <Item>ui/mp-observer/mp-observer-eye.js</Item>
                    <Item>ui/mp-observer/mp-observer-prompts.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>

<!--*********************** GAME: OBSERVER BASE-GAME OVERRIDES ***********************************-->

        <!-- Copies of base-game files (changes marked "ZOM:"), loaded only in a
             game with an Observer: every other game runs the untouched files,
             or another mod's versions of them. Loaded after Multiplayer
             Toolkit's copies (LoadOrder), so these win in this mod's games. -->
        <ActionGroup id="zom-observer-overrides" scope="game" criteria="zom-observer-in-game">
            <Properties><LoadOrder>1100</LoadOrder></Properties>
            <Actions>
                <ImportFiles>
                    <Item>maps/assign-starting-plots.js</Item>
                    <Item>scripts/age-transition-post-load.js</Item>
                    <Item>ui-next/screens/victories/victories-screen-model.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen-model.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen-empire-tab.js</Item>
                    <Item>ui-next/screens/commerce/commerce-screen-trade-tab.js</Item>
                    <Item>ui-next/screens/legacies/legacies-screen.js</Item>
                    <Item>ui-next/screens/legacies/legacies-model.js</Item>
                    <Item>ui-next/screens/legacies/dedications-model.js</Item>
                    <Item>ui/policies/government-hub.js</Item>
                    <Item>ui/policies/model-government.js</Item>
                    <Item>ui/policies/model-policies.js</Item>
                    <Item>ui/policies/policies-support.js</Item>
                    <Item>ui/great-works/model-great-works.js</Item>
                    <Item>ui/tech-tree/model-tech-tree.js</Item>
                    <Item>ui/culture-tree/model-culture-tree.js</Item>
                    <Item>ui/tree-grid/tree-grid.js</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>

    </ActionGroups>

<!--************************* LOCALIZED TEXT ************************************************-->

    <LocalizedText>
        <File>text/en_us/mod-info-text.xml</File>
    </LocalizedText>
</Mod>