<?xml version="1.0" encoding="utf-8"?>
<Mod id="multiplayer-toolkit" version="00600" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_MPT_NAME</Name>
        <Description>LOC_MOD_MPT_DESCRIPTION</Description>
        <Authors>Zatygold</Authors>
        <Package>Mod</Package>
        <AffectsSavedGames>0</AffectsSavedGames>
        <Version>0.6.00</Version>
        <LastUpdated>2026-09-27</LastUpdated>
        <ShowInBrowser>1</ShowInBrowser>
    </Properties>

    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
        <Mod id="age-antiquity" title="LOC_MODULE_AGE_ANTIQUITY_NAME"/>
        <Mod id="age-exploration" title="LOC_MODULE_AGE_EXPLORATION_NAME"/>
        <Mod id="age-modern" title="LOC_MODULE_AGE_MODERN_NAME"/>
    </Dependencies>

    <ActionCriteria>
        <Criteria id="always"><AlwaysMet/></Criteria>

<!--*************************** CRITERIA: COMPETITIVE TIMER ****************************************-->

        <Criteria id="antiquity-age-current">
            <AgeInUse>AGE_ANTIQUITY</AgeInUse>
        </Criteria>
        <Criteria id="exploration-age-current">
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
        </Criteria>
        <Criteria id="modern-age-current">
            <AgeInUse>AGE_MODERN</AgeInUse>
        </Criteria>
    </ActionCriteria>

<!--*************************** SHELL: TEXT/SETTINGS ***********************************************-->

    <ActionGroups>
        <ActionGroup id="mpt-shell" scope="shell" criteria="always">
            <Properties><LoadOrder>1000</LoadOrder></Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/mpt-text.xml</Item>
                </UpdateText>
                <UpdateDatabase>
                    <Item>config/SetupParameters.sql</Item>
                    <Item>config/mpt-input.sql</Item>
                    <Item>config/observer-config.xml</Item>
                </UpdateDatabase>
                <ImportFiles>
                    <Item>icons/mpt_observer.png</Item>
                    <Item>icons/mpt_observer_civ.png</Item>
                    <Item>icons/mpt_observer_leader_256.png</Item>
                    <Item>icons/mpt_observer_leader_140.png</Item>
                    <Item>icons/mpt_observer_leader_128.png</Item>
                    <Item>icons/mpt_observer_leader_64.png</Item>
                    <Item>icons/mpt_observer_circle_256.png</Item>
                    <Item>icons/mpt_observer_circle_140.png</Item>
                    <Item>icons/mpt_observer_circle_128.png</Item>
                    <Item>icons/mpt_observer_circle_64.png</Item>
                </ImportFiles>
                <UpdateIcons>
                    <Item>data/observer/observer-icons.xml</Item>
                </UpdateIcons>
                <UpdateColors>
                    <Item>data/observer/observer-colors.xml</Item>
                </UpdateColors>
                <UIScripts>
                    <Item>ui/mpt-shared/mpt-util.js</Item>
                    <Item>ui/mp-lobby/mp-lobby-config.js</Item>
                    <Item>ui/mp-lobby/mp-lobby-observer.js</Item>
                    <Item>ui/mp-lobby/mp-lobby-tooltips.js</Item>
                    <Item>ui/mp-keybind/mp-keybind.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>

<!--***************************** GAME: TEXT & SHARED HELPERS *************************************-->

        <ActionGroup id="mpt-game-text" scope="game" criteria="always">
            <Properties><LoadOrder>500</LoadOrder></Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/mpt-text.xml</Item>
                </UpdateText>
                <UIScripts>
                    <Item>ui/mpt-shared/mpt-util.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>

<!--*************************** GAME: PAUSE BUTTON ***********************************************-->

        <ActionGroup id="mpt-pause-button" scope="game" criteria="always">
            <Properties><LoadOrder>1000</LoadOrder></Properties>
            <Actions>
                <UIScripts>
                    <Item>ui/mp-pause/mp-pause-config.js</Item>
                    <Item>ui/mp-pause/mp-pause.scss.js</Item>
                    <Item>ui/mp-pause/mp-pause-overlay.js</Item>
                    <Item>ui/mp-pause/mp-pause-net.js</Item>
                    <Item>ui/mp-pause/mp-pause-mgr.js</Item>
                    <Item>ui/mp-keybind/mp-keybind.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>



<!--*********************** GAME: OBSERVER LEADER & CIVILIZATIONS ******************************-->

        <ActionGroup id="mpt-observer" scope="game" criteria="always">
            <Properties><LoadOrder>1000</LoadOrder></Properties>
            <Actions>
                <ImportFiles>
                    <Item>maps/assign-starting-plots.js</Item>
                    <Item>maps/mpt-observer-eye.js</Item>
                    <Item>scripts/age-transition-post-load.js</Item>
                    <Item>ui-next/screens/victories/victories-screen-model.js</Item>
                </ImportFiles>
                <UpdateDatabase>
                    <Item>data/observer/observer-leader.xml</Item>
                    <Item>data/observer/observer-civilizations.xml</Item>
                    <Item>data/observer/observer-units-gameeffects.xml</Item>
                    <Item>data/observer/observer-units.xml</Item>
                </UpdateDatabase>
                <ImportFiles>
                    <Item>icons/mpt_observer.png</Item>
                    <Item>icons/mpt_observer_civ.png</Item>
                    <Item>icons/mpt_observer_leader_256.png</Item>
                    <Item>icons/mpt_observer_leader_140.png</Item>
                    <Item>icons/mpt_observer_leader_128.png</Item>
                    <Item>icons/mpt_observer_leader_64.png</Item>
                    <Item>icons/mpt_observer_circle_256.png</Item>
                    <Item>icons/mpt_observer_circle_140.png</Item>
                    <Item>icons/mpt_observer_circle_128.png</Item>
                    <Item>icons/mpt_observer_circle_64.png</Item>
                </ImportFiles>
                <UpdateIcons>
                    <Item>data/observer/observer-icons.xml</Item>
                </UpdateIcons>
                <UpdateColors>
                    <Item>data/observer/observer-colors.xml</Item>
                </UpdateColors>
                <UIScripts>
                    <Item>ui/mp-observer/mp-observer-config.js</Item>
                    <Item>ui/mp-observer/mp-observer-core.js</Item>
                    <Item>ui/mp-observer/mp-observer-overview.js</Item>
                    <Item>ui/mp-observer/mp-observer-screens.js</Item>
                    <Item>ui/mp-observer/mp-observer-ribbon-data.js</Item>
                    <Item>ui/mp-observer/mp-observer-ribbon-style.js</Item>
                    <Item>ui/mp-observer/mp-observer-ribbon-toolbar.js</Item>
                    <Item>ui/mp-observer/mp-observer-ribbon.js</Item>
                    <Item>ui/mp-observer/mp-observer-navigation.js</Item>
                    <Item>ui/mp-observer/mp-observer-victory.js</Item>
                    <Item>ui/mp-observer/mp-observer-diplomacy.js</Item>
                    <Item>ui/mp-observer/mp-observer-units.js</Item>
                    <Item>ui/mp-observer/mp-observer-combat.js</Item>
                    <Item>ui/mp-observer/mp-observer-eye.js</Item>
                    <Item>ui/mp-observer/mp-observer-prompts.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>

<!--*********************** GAME: COMPETITIVE TIMER SCRIPT ***************************************-->

        <ActionGroup id="mpt-competitive-timer-script" scope="game" criteria="always">
            <Properties><LoadOrder>1000</LoadOrder></Properties>
            <Actions>
                <UIScripts>
                    <Item>ui/mp-timer/mp-timer-config.js</Item>
                    <Item>ui/mp-timer/mp-timer.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>

<!--**************************** GAME: TURN TIMER ************************************************-->

        <ActionGroup id="mpt-turn-timer-schema" scope="game" criteria="always">
            <Properties><LoadOrder>900</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/timers/TimerScaling.sql</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>

    <!--**************************** TURN TIMER: COMPETITIVE *************************************-->

        <ActionGroup id="mpt-turn-timer-antiquity" scope="game" criteria="antiquity-age-current">
            <Properties><LoadOrder>1000</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/timers/antiquity/CompetitiveTimer.sql</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>

        <ActionGroup id="mpt-turn-timer-exploration" scope="game" criteria="exploration-age-current">
            <Properties><LoadOrder>1000</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/timers/exploration/CompetitiveTimer.sql</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>

        <ActionGroup id="mpt-turn-timer-modern" scope="game" criteria="modern-age-current">
            <Properties><LoadOrder>1000</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/timers/modern/CompetitiveTimer.sql</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
    </ActionGroups>

<!--************************* LOCALIZED TEXT ************************************************-->

    <LocalizedText>
        <File>text/en_us/mod-info-text.xml</File>
    </LocalizedText>
</Mod>